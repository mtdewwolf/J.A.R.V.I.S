{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/contracts/0.1/inference-request.schema.json",
  "title": "InferenceRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "generationId", "deadlineMs", "maxTurns", "maxOutputTokens", "model", "system", "messages", "tools"],
  "properties": {
    "contractVersion": { "const": "0.1" },
    "generationId": { "type": "string", "pattern": "^g_[A-Za-z0-9._-]{8,64}$" },
    "deadlineMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
    "maxTurns": { "type": "integer", "minimum": 1, "maximum": 4 },
    "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 32768 },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "system": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "const": "system" },
          "content": { "type": "string", "maxLength": 65536 }
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content", "untrusted"],
        "properties": {
          "role": { "enum": ["user", "assistant", "tool"] },
          "content": { "type": "string", "maxLength": 65536 },
          "untrusted": { "const": true }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "schema"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "version": { "type": "integer", "minimum": 1 },
          "schema": { "type": "object" }
        }
      }
    }
  }
}
